<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two builds of the same source, one per Steam branch:
         dotnet build -c Il2Cpp   default branch   (net6.0)
         dotnet build -c Mono     alternate branch (netstandard2.1)
       Every game type is reached through MDSAPI, so neither build references the game's
       own assemblies — only Unity, MelonLoader and MDSAPI. A game update that moves
       something is fixed in MDSAPI, not here. -->
  <PropertyGroup>
    <AssemblyName>SCH1_StackLimitPlus</AssemblyName>
    <RootNamespace>SCH1_StackLimitPlus</RootNamespace>
    <Configurations>Il2Cpp;Mono</Configurations>
    <Platforms>AnyCPU</Platforms>
    <!-- C# 9: C# 10 compiles $"..." into DefaultInterpolatedStringHandler, which the Mono
         runtime does not have. Both builds use 9 so the source stays one source. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- net6.0 is what MelonLoader's IL2CPP runtime is; the SDK's out-of-support warning does not apply -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Version>2.1.1</Version>
  </PropertyGroup>

  <!-- Paths. Defaults assume this repo sits two folders below the Steam library, as it did
       before; override any of them in local.build.props (gitignored) on another machine. -->
  <Import Project="$(MSBuildThisFileDirectory)local.build.props" Condition="Exists('$(MSBuildThisFileDirectory)local.build.props')" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\SteamLibrary\steamapps\common\Schedule I</GameDir>
    <Il2CppAssembliesPath Condition="'$(Il2CppAssembliesPath)' == ''">$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppAssembliesPath>
    <MelonLoaderNet6Path Condition="'$(MelonLoaderNet6Path)' == ''">$(GameDir)\MelonLoader\net6</MelonLoaderNet6Path>
    <MelonLoaderNet35Path Condition="'$(MelonLoaderNet35Path)' == ''">$(GameDir)\MelonLoader\net35</MelonLoaderNet35Path>
    <!-- Only exists while the alternate branch is installed. Copy it somewhere permanent
         once (e.g. D:\SCHEDULE1MODS\_refs\Mono) and point this at the copy to build Mono
         from either branch. -->
    <MonoAssembliesPath Condition="'$(MonoAssembliesPath)' == ''">$(GameDir)\Schedule I_Data\Managed</MonoAssembliesPath>
    <MdsApiPath Condition="'$(MdsApiPath)' == ''">$(GameDir)\Mods\MDSAPI</MdsApiPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Il2Cpp'">
    <TargetFramework Condition="'$(TargetFramework)' == ''">net6.0</TargetFramework>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Mono'">
    <TargetFramework Condition="'$(TargetFramework)' == ''">netstandard2.1</TargetFramework>
    <DefineConstants>$(DefineConstants);MONO</DefineConstants>
    <!-- The Mono branch ships a newer TextMeshPro that marks enableWordWrapping obsolete in
         favour of textWrappingMode; the IL2CPP branch's TextMeshPro has only the old property,
         so the shared source keeps it. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Il2Cpp'">
    <Reference Include="MDSAPI"><HintPath>$(MdsApiPath)\Il2Cpp\MDSAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(MelonLoaderNet6Path)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(MelonLoaderNet6Path)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(MelonLoaderNet6Path)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(MelonLoaderNet6Path)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(Il2CppAssembliesPath)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(Il2CppAssembliesPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Il2CppAssembliesPath)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Mono'">
    <Reference Include="MDSAPI"><HintPath>$(MdsApiPath)\Mono\MDSAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(MelonLoaderNet35Path)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(MonoAssembliesPath)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(MonoAssembliesPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(MonoAssembliesPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(MonoAssembliesPath)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(MonoAssembliesPath)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(MonoAssembliesPath)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(MonoAssembliesPath)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(MonoAssembliesPath)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(MonoAssembliesPath)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Opt in from local.build.props with <AutomateLocalDeployment>true</AutomateLocalDeployment>.
       Both builds live side by side in Mods\StackLimitPlus\<Il2Cpp|Mono>; MDSAPILoader
       (0.2.1+) loads the one matching the branch at every launch, so switching branch needs
       no rebuild or copy. A copy straight in Mods from older installs is removed. -->
  <Target Name="DeployLocal" AfterTargets="Build" Condition="'$(AutomateLocalDeployment)' == 'true'">
    <MakeDir Directories="$(GameDir)\Mods\StackLimitPlus\$(Configuration)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods\StackLimitPlus\$(Configuration)" />
    <Delete Files="$(GameDir)\Mods\$(TargetFileName)" />
  </Target>

</Project>
